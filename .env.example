# Copy to .env for local development. NEVER commit real values; production secrets live in Azure Key Vault / GitHub Environments.
EMBLEM_ENV=dev
EMBLEM_DB=build/emblem.duckdb
EMBLEM_AS_OF=2026-09-30
# Required (and validated) when EMBLEM_ENV=prod. In dev, ephemeral random secrets are generated at startup.
EMBLEM_AUTH_SECRET=
EMBLEM_WEBHOOK_SECRET=
EMBLEM_MASTER_SECRET=
# Optional alert sink (Teams/Slack/PagerDuty webhook)
EMBLEM_ALERT_WEBHOOK=
