    "roles": [
      {
        "name": "Sales rep",
        "modelPermission": "read",
        "tablePermissions": [
          {
            "name": "dim_company",
            "filterExpression": "dim_company[account_owner] = USERPRINCIPALNAME()"
          }
        ]
      },
      {
        "name": "Plant manager",
        "modelPermission": "read",
        "tablePermissions": [
          {
            "name": "dim_location",
            "filterExpression": "dim_location[location_key] IN {\"HOL-FL\"}"
          }
        ]
      }
    ]
