      {
        "name": "fact_revenue",
        "columns": [
          {
            "name": "revenue_key",
            "dataType": "string",
            "isHidden": true
          },
          {
            "name": "order_no",
            "dataType": "string",
            "isHidden": false
          },
          {
            "name": "posting_date",
            "dataType": "dateTime",
            "isHidden": false
          },
          {
            "name": "posting_month",
            "dataType": "dateTime",
            "isHidden": false
          },
          {
            "name": "amount_usd",
            "dataType": "double",
            "isHidden": false
          },
          {
            "name": "currency",
            "dataType": "string",
            "isHidden": false
          },
          {
            "name": "customer_no",
            "dataType": "string",
            "isHidden": false
          },
          {
            "name": "company_key",
            "dataType": "string",
            "isHidden": true
          },
          {
            "name": "lines_total",
            "dataType": "double",
            "isHidden": false
          },
          {
            "name": "lines_variance",
            "dataType": "double",
            "isHidden": false
          }
        ],
        "measures": [
          {
            "name": "Total Revenue",
            "expression": "SUM(fact_revenue[amount_usd])"
          },
          {
            "name": "Invoice Count",
            "expression": "COUNTROWS(fact_revenue)"
          },
          {
            "name": "Revenue YoY %",
            "expression": "VAR cur = [Total Revenue] VAR py = CALCULATE([Total Revenue], DATEADD(fact_revenue[posting_date], -1, YEAR)) RETURN DIVIDE(cur - py, py)"
          },
          {
            "name": "Invoice Variance",
            "expression": "SUM(fact_revenue[lines_variance])"
          }
        ],
        "partitions": [
          {
            "name": "fact_revenue",
            "mode": "directLake",
            "source": {
              "type": "entity",
              "entityName": "fact_revenue",
              "schemaName": "gold"
            }
          }
        ]
      },
      {
