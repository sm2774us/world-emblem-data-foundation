            "dataType": "dateTime",
            "isHidden": false
          },
          {
            "name": "cycle_hours",
            "dataType": "double",
            "isHidden": false
          }
        ],
        "measures": [
          {
            "name": "Scrap Rate",
            "expression": "DIVIDE(SUM(fact_production[qty_scrap]), SUM(fact_production[qty_planned]))"
          },
          {
            "name": "Yield %",
            "expression": "1 - [Scrap Rate]"
          }
        ],
        "partitions": [
          {
            "name": "fact_production",
            "mode": "directLake",
            "source": {
              "type": "entity",
