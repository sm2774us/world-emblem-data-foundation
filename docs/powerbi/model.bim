            "dataType": "string",
            "isHidden": false
          },
          {
            "name": "external_doc_no",
            "dataType": "string",
            "isHidden": false
          }
        ],
        "measures": [
          {
            "name": "Orders",
            "expression": "DISTINCTCOUNT(fact_order_line[order_no])"
          },
          {
            "name": "Avg Order Value",
            "expression": "DIVIDE(SUM(fact_order_line[line_amount]), [Orders])"
          }
        ],
        "partitions": [
